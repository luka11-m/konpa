rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User data - only accessible by the user themselves
    match /users/{uid} {
      allow read, write: if request.auth.uid == uid;
    }

    // Groups - accessible by group members
    match /groups/{groupId} {
      allow read, write: if request.auth.uid in resource.data.members;
      allow create: if request.auth != null;
    }

    // Matching conditions - all authenticated users can read and write
    match /matchingConditions/{docId} {
      allow read, write: if request.auth != null;
    }

    // Matches - authenticated users can read, no direct write
    match /matches/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Stores - all authenticated users can read
    match /stores/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
